{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "description": "Marketplace backend: HTTP/WebSocket API and background worker",
  "scripts": {
    "dev": "nest start --watch",
    "dev:worker": "nest start --watch --entryFile worker",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --config test/jest-e2e.json --maxWorkers=1 --workerIdleMemoryLimit=1024MB --passWithNoTests",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset && prisma db seed && prisma generate",
    "db:seed": "prisma db seed",
    "db:seed:history": "tsx prisma/seed-history.ts",
    "db:studio": "prisma studio",
    "search:reindex": "nest build && node dist/scripts/search-reindex.js",
    "openapi:export": "nest build && NODE_ENV=test node dist/scripts/openapi-export.js"
  },
  "dependencies": {
    "@keyv/redis": "^5.1.6",
    "@nestjs-cls/transactional": "^4.0.1",
    "@nestjs-cls/transactional-adapter-prisma": "^2.0.1",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/cache-manager": "^12.0.1",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/platform-socket.io": "^11.2.7",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^11.2.7",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@prometheus-io/client": "^0.16.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "@willsoto/nestjs-prometheus": "^7.0.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.17",
    "cache-manager": "^7.2.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.8",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "meilisearch": "^0.62.0",
    "nestjs-cls": "^7.0.1",
    "nestjs-pino": "^5.3.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.18.1",
    "socket.io": "^4.8.4",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "prisma": "7.10.1",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15"
  }
}

# Development profile. Copy to `.env` and adjust:
#   cp .env.example .env
#
# Load order (first value wins):
#   .env.<NODE_ENV>.local  ->  .env.<NODE_ENV>  ->  .env
# NODE_ENV defaults to `development`; the test profile lives in `.env.test`.
# Variables already present in the process environment always take precedence.
#
# Secrets below are placeholders for local development only.

# --- Application -------------------------------------------------------------
NODE_ENV=development
# HTTP port of the api process.
PORT=3000
# Log level: fatal | error | warn | info | debug | trace | silent. Development logs are pretty-printed,
# every other profile writes JSON lines.
LOG_LEVEL=debug
# Browser origin of the SPA (Vite dev server); the only origin CORS allows.
WEB_URL=http://localhost:5173
# Reverse-proxy hops in front of the api (0 = none; the compose stack sets 1 for nginx).
TRUST_PROXY=0
# Maximum request body size.
BODY_LIMIT=100kb
# The worker serves /metrics on this port; the api serves it on PORT.
WORKER_METRICS_PORT=9100

# --- Rate limiting --------------------------------------------------------------
# LIMIT = requests per window, TTL = window length in seconds.
THROTTLE_DEFAULT_LIMIT=100
THROTTLE_DEFAULT_TTL=60
THROTTLE_LOGIN_LIMIT=5
THROTTLE_LOGIN_TTL=60
THROTTLE_REGISTER_LIMIT=10
THROTTLE_REGISTER_TTL=60
THROTTLE_REFRESH_LIMIT=30
THROTTLE_REFRESH_TTL=60
# Bids are limited per authenticated user.
THROTTLE_BID_LIMIT=10
THROTTLE_BID_TTL=10

# --- PostgreSQL ---------------------------------------------------------------
# Credentials of the compose `postgres` service. Keep them URL-safe: they are
# interpolated into DATABASE_URL inside the containers.
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=marketplace
POSTGRES_DB=marketplace
# Used by the api, the worker and the Prisma CLI when they run on the host.
DATABASE_URL=postgresql://marketplace:marketplace@localhost:5432/marketplace

# Used by `npm run db:seed`: the platform admin and the shared password of the demo accounts
# (3 approved sellers, 1 pending applicant, 3 buyers at <name>@example.com).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin
SEED_DEMO_PASSWORD=change-me-demo

# --- Redis --------------------------------------------------------------------
# The database index in the path separates profiles (dev: 0, test: 1).
REDIS_URL=redis://localhost:6379/0

# --- Meilisearch --------------------------------------------------------------
MEILI_HOST=http://localhost:7700
# At least 16 characters. Also used as the master key of the compose service.
MEILI_MASTER_KEY=dev-master-key-change-me
# Prepended to every index name so profiles never share indexes.
MEILI_INDEX_PREFIX=dev_

# --- docker compose (host ports) ----------------------------------------------
WEB_PORT=8080
API_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
MEILI_PORT=7700

# Test profile (loaded when NODE_ENV=test, which Jest sets). Non-secret values
# for a throwaway local stack and CI services; never use them anywhere else.

NODE_ENV=test
PORT=3001

# Keeps test output readable; specs that assert on logs raise it for their own app.
LOG_LEVEL=silent

# Generous, so unrelated specs never hit the limiter; specs for it set their own values.
THROTTLE_DEFAULT_LIMIT=1000

# Polls fast, so specs that wait for the relay stay quick.
OUTBOX_POLL_INTERVAL_MS=50

# Products are published at once and reviewed afterwards; specs for the other mode override it.
PRODUCT_PREMODERATION=false

# 0 = let the OS pick a free port, so parallel runs never collide.
WORKER_METRICS_PORT=0

# `marketplace_test` is created by docker/postgres/init/01-create-test-db.sql.
DATABASE_URL=postgresql://marketplace:marketplace@localhost:5432/marketplace_test

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=test-admin-password
SEED_DEMO_PASSWORD=test-demo-password

JWT_ACCESS_SECRET=test-jwt-access-secret-0123456789-abcdef

# Redis database 1 keeps tests away from development data.
REDIS_URL=redis://localhost:6379/1

MEILI_HOST=http://localhost:7700
# Matches the compose default key, so `docker compose up -d` serves the e2e tests as is.
MEILI_MASTER_KEY=dev-master-key-change-me
MEILI_INDEX_PREFIX=test_

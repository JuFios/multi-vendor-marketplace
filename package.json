{
  "name": "multi-vendor-marketplace",
  "version": "0.0.0",
  "private": true,
  "description": "Multi-vendor marketplace with real-time inventory",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present && eslint load",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p load",
    "test": "npm run test --workspaces --if-present",
    "load:up": "docker compose -f docker-compose.yml -f docker-compose.load.yml up --build -d",
    "load:seed": "npm exec -w apps/api -- tsx ../../load/seed-load.ts",
    "load:bids": "docker compose -f docker-compose.yml -f docker-compose.load.yml run --rm k6 run --quiet /load/bids.js",
    "load:checkout": "docker compose -f docker-compose.yml -f docker-compose.load.yml run --rm k6 run --quiet /load/checkout.js",
    "load:verify": "npm exec -w apps/api -- tsx ../../load/verify.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.2"
  }
}
